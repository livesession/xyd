{
  "description": "processSource with a .yaml `output` (js-yaml dump). Kept isolated: serializeDoc yaml needs the lazily-loaded dumper.",
  "ops": [
    {
      "id": "yaml-output",
      "op": "processSource",
      "source": {
        "inputs": [
          {
            "location": "./base.json"
          }
        ],
        "output": "./out/spec.yaml"
      }
    },
    {
      "id": "yml-output",
      "op": "processSource",
      "source": {
        "inputs": [
          {
            "location": "./base.json"
          }
        ],
        "output": "./out/spec.yml"
      }
    },
    {
      "id": "yaml-output-tricky",
      "op": "processSource",
      "source": {
        "inputs": [
          {
            "location": "./tricky.json"
          }
        ],
        "output": "./out/tricky.yaml"
      }
    }
  ]
}
