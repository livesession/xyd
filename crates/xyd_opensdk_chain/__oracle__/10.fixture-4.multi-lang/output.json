{
  "resolveChain": {
    "ok": true,
    "value": {
      "version": 1,
      "sources": {
        "svc": {
          "inputs": [
            {
              "location": "./specs/svc.json"
            }
          ],
          "output": "./.chain/svc.openapi.json"
        }
      },
      "targets": {
        "svc-go": {
          "target": "go",
          "source": "svc",
          "output": "./sdk/go",
          "sdkName": "svc"
        },
        "svc-ts": {
          "target": "typescript",
          "source": "svc",
          "output": "./sdk/ts",
          "sdkName": "svc",
          "options": {
            "packageName": "svc"
          }
        },
        "svc-py": {
          "target": "python",
          "source": "svc",
          "output": "./sdk/py",
          "sdkName": "svc"
        }
      }
    }
  },
  "detectChain": {
    "ok": true,
    "value": "<CWD>/chain.json"
  },
  "source:svc": {
    "ok": true,
    "value": {
      "outPath": "<CWD>/.chain/svc.openapi.json",
      "content": "{\n  \"openapi\": \"3.0.3\",\n  \"info\": {\n    \"title\": \"Svc\",\n    \"version\": \"1.0.0\"\n  },\n  \"paths\": {\n    \"/widgets\": {\n      \"get\": {\n        \"operationId\": \"listWidgets\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"ok\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/Widget\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  },\n  \"components\": {\n    \"schemas\": {\n      \"Widget\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}\n"
    }
  }
}
