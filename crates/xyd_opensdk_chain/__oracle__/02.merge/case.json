{
  "description": "mergeOpenApiDocs: union, operation granularity, tags/security dedup, JS numeric identity",
  "ops": [
    {
      "id": "disjoint",
      "op": "mergeOpenApiDocs",
      "inputs": [
        "./a.json",
        "./b.json"
      ]
    },
    {
      "id": "operation-granularity",
      "op": "mergeOpenApiDocs",
      "inputs": [
        "./pets-get.json",
        "./pets-post.json"
      ]
    },
    {
      "id": "single-input-materialises-keys",
      "op": "mergeOpenApiDocs",
      "inputs": [
        "./bare.json"
      ]
    },
    {
      "id": "bare-first",
      "op": "mergeOpenApiDocs",
      "inputs": [
        "./bare.json",
        "./a.json"
      ]
    },
    {
      "id": "tags-and-security",
      "op": "mergeOpenApiDocs",
      "inputs": [
        "./tagged-a.json",
        "./tagged-b.json"
      ]
    },
    {
      "id": "security-only-in-second",
      "op": "mergeOpenApiDocs",
      "inputs": [
        "./bare.json",
        "./tagged-b.json"
      ]
    },
    {
      "id": "numeric-identity-dedup",
      "op": "mergeOpenApiDocs",
      "inputs": [
        "./num-int.json",
        "./num-float.json"
      ]
    },
    {
      "id": "three-way",
      "op": "mergeOpenApiDocs",
      "inputs": [
        "./a.json",
        "./b.json",
        "./pets-get.json"
      ]
    },
    {
      "id": "inputs-not-mutated",
      "op": "readRawDoc",
      "location": "./pets-get.json"
    }
  ]
}
