          "pathParams": [
            {
              "name": "pet_id",
              "type": {
                "kind": "scalar",
                "scalar": "string"
              },
              "required": true
            }
          ],
          "responses": [
            {
              "status": "200",
              "description": "The pet.",
              "contentType": "application/json",
              "type": {
                "kind": "ref",
                "name": "Pet"
              }
            }
          ],
          "primaryResponse": {
            "kind": "ref",
            "name": "Pet"
          }
        },
        {
          "action": "download_photo",
          "httpMethod": "get",
          "path": "/pets/{pet_id}/photo",
          "operationId": "downloadPetPhoto",
          "description": "Download a pet's photo",
          "pathParams": [
            {
              "name": "pet_id",
              "type": {
                "kind": "scalar",
                "scalar": "string"
              },
              "required": true
            }
          ],
          "responses": [
            {
              "status": "200",
              "description": "The photo bytes.",
              "contentType": "application/binary",
              "type": {
                "kind": "scalar",
                "scalar": "string",
                "format": "binary"
              }
            }
          ],
          "primaryResponse": {
            "kind": "scalar",
            "scalar": "string",
            "format": "binary"
          }
        }
      ]
    }
  ]
}
