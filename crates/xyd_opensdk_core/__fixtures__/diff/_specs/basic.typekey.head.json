              "contentType": "application/json",
              "type": {
                "kind": "ref",
                "name": "PetList"
              }
            }
          ],
          "primaryResponse": {
            "kind": "ref",
            "name": "PetList"
          },
          "pagination": {
            "style": "cursor",
            "itemsField": "data",
            "nextField": "has_more",
            "itemType": {
              "kind": "ref",
              "name": "Pet"
            },
            "cursorParam": "after",
            "limitParam": "limit"
          }
        },
        {
          "action": "create",
          "httpMethod": "post",
          "path": "/pets",
          "operationId": "createPet",
          "description": "Create a pet",
          "requestBody": {
            "contentType": "application/json",
            "type": {
              "kind": "ref",
              "name": "CreatePetRequest"
            },
            "required": true,
            "encoding": "json"
          },
          "responses": [
            {
              "status": "200",
              "description": "The created pet.",
              "contentType": "application/json",
              "type": {
                "kind": "ref",
                "name": "Pet"
              }
            }
          ],
          "primaryResponse": {
            "kind": "ref",
            "name": "Pet"
          }
        },
        {
          "action": "retrieve",
          "httpMethod": "get",
          "path": "/pets/{pet_id}",
          "operationId": "getPet",
