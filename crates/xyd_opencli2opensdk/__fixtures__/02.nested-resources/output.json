{
  "opensdk": "1.0.0",
  "info": {
    "title": "acme",
    "version": "0.1.0"
  },
  "x-cli": {
    "bin": "acme",
    "envVar": "ACME_BIN",
    "opencli": "1.0.0"
  },
  "types": [
    {
      "name": "CommandResult",
      "kind": "struct",
      "fields": [
        {
          "name": "stdout",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "stderr",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "exitCode",
          "type": {
            "kind": "scalar",
            "scalar": "integer"
          },
          "required": true
        }
      ],
      "description": "The result of one CLI invocation. json() parses stdout as JSON."
    }
  ],
  "resources": [
    {
      "name": "chat",
      "resources": [
        {
          "name": "completions",
          "methods": [
            {
              "action": "list",
              "description": "List completions",
              "primaryResponse": {
                "kind": "ref",
                "name": "CommandResult"
              },
              "x-cli": {
                "command": [
                  "chat",
                  "completions",
                  "list"
                ]
              }
            },
            {
              "action": "create",
              "description": "Create a completion",
              "queryParams": [
                {
                  "name": "model",
                  "type": {
                    "kind": "scalar",
                    "scalar": "string"
                  },
                  "required": true,
                  "description": "Model id"
                }
              ],
              "primaryResponse": {
                "kind": "ref",
                "name": "CommandResult"
              },
              "x-cli": {
                "command": [
                  "chat",
                  "completions",
                  "create"
                ],
                "options": [
                  {
                    "flag": "--model",
                    "from": "param:model",
                    "encoding": "string"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "config",
      "methods": [
        {
          "action": "get",
          "pathParams": [
            {
              "name": "key",
              "type": {
                "kind": "scalar",
                "scalar": "string"
              },
              "required": true,
              "description": "Config key"
            }
          ],
          "primaryResponse": {
            "kind": "ref",
            "name": "CommandResult"
          },
          "x-cli": {
            "command": [
              "config",
              "get"
            ],
            "args": [
              {
                "from": "param:key",
                "encoding": "string",
                "required": true
              }
            ]
          }
        }
      ]
    }
  ],
  "sdk": {
    "mode": "cli",
    "timeout": {
      "defaultTimeoutMs": 60000,
      "onTimeout": "kill"
    },
    "errors": {
      "nonZeroExit": "raise",
      "errorName": "CliError"
    },
    "result": {
      "typeName": "CommandResult",
      "jsonHelper": true
    },
    "process": {
      "inheritEnv": true,
      "stdin": "null"
    },
    "clientOptions": {
      "optionKeys": [
        "binPath",
        "cwd",
        "env",
        "timeout"
      ]
    }
  }
}
