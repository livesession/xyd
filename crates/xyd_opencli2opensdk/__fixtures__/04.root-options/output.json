{
  "opensdk": "1.0.0",
  "info": {
    "title": "rooty",
    "version": "1.0.0"
  },
  "x-cli": {
    "bin": "rooty",
    "envVar": "ROOTY_BIN",
    "opencli": "1.0.0"
  },
  "types": [
    {
      "name": "CommandResult",
      "kind": "struct",
      "fields": [
        {
          "name": "stdout",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "stderr",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "exitCode",
          "type": {
            "kind": "scalar",
            "scalar": "integer"
          },
          "required": true
        }
      ],
      "description": "The result of one CLI invocation. json() parses stdout as JSON."
    }
  ],
  "methods": [
    {
      "action": "lint",
      "queryParams": [
        {
          "name": "verbose",
          "type": {
            "kind": "scalar",
            "scalar": "boolean"
          },
          "required": false,
          "description": "Lint-specific verbosity"
        },
        {
          "name": "logLevel",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": false,
          "description": "Log level"
        }
      ],
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [
          "lint"
        ],
        "options": [
          {
            "flag": "--verbose",
            "from": "param:verbose",
            "encoding": "boolean"
          },
          {
            "flag": "--logLevel",
            "from": "param:logLevel",
            "encoding": "string"
          }
        ]
      }
    },
    {
      "action": "opt-help",
      "description": "Print help",
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [],
        "options": [
          {
            "flag": "--help"
          }
        ]
      }
    },
    {
      "action": "opt-no-color",
      "description": "Disable colors",
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [],
        "options": [
          {
            "flag": "--no-color"
          }
        ]
      }
    },
    {
      "action": "opt-version",
      "description": "Print version",
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [],
        "options": [
          {
            "flag": "--version"
          }
        ]
      }
    },
    {
      "action": "run",
      "description": "Run it",
      "queryParams": [
        {
          "name": "verbose",
          "type": {
            "kind": "scalar",
            "scalar": "boolean"
          },
          "required": false,
          "description": "Verbose output"
        },
        {
          "name": "logLevel",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": false,
          "description": "Log level"
        }
      ],
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [
          "run"
        ],
        "options": [
          {
            "flag": "--verbose",
            "from": "param:verbose",
            "encoding": "boolean"
          },
          {
            "flag": "--logLevel",
            "from": "param:logLevel",
            "encoding": "string"
          }
        ]
      }
    }
  ],
  "sdk": {
    "mode": "cli",
    "timeout": {
      "defaultTimeoutMs": 60000,
      "onTimeout": "kill"
    },
    "errors": {
      "nonZeroExit": "raise",
      "errorName": "CliError"
    },
    "result": {
      "typeName": "CommandResult",
      "jsonHelper": true
    },
    "process": {
      "inheritEnv": true,
      "stdin": "null"
    },
    "clientOptions": {
      "optionKeys": [
        "binPath",
        "cwd",
        "env",
        "timeout"
      ]
    }
  }
}
