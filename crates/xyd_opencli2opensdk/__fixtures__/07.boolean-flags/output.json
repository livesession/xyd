{
  "opensdk": "1.0.0",
  "info": {
    "title": "flags",
    "version": "1.0.0"
  },
  "x-cli": {
    "bin": "flags",
    "envVar": "FLAGS_BIN",
    "opencli": "1.0.0"
  },
  "types": [
    {
      "name": "CommandResult",
      "kind": "struct",
      "fields": [
        {
          "name": "stdout",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "stderr",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "exitCode",
          "type": {
            "kind": "scalar",
            "scalar": "integer"
          },
          "required": true
        }
      ],
      "description": "The result of one CLI invocation. json() parses stdout as JSON."
    }
  ],
  "methods": [
    {
      "action": "watch",
      "description": "Watch for changes",
      "queryParams": [
        {
          "name": "force",
          "type": {
            "kind": "scalar",
            "scalar": "boolean"
          },
          "required": false,
          "description": "Force it"
        },
        {
          "name": "q",
          "type": {
            "kind": "scalar",
            "scalar": "boolean"
          },
          "required": false,
          "description": "Quiet mode"
        },
        {
          "name": "dryRun",
          "type": {
            "kind": "scalar",
            "scalar": "boolean"
          },
          "required": false,
          "wireName": "dry-run",
          "description": "Do not write anything"
        }
      ],
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [
          "watch"
        ],
        "options": [
          {
            "flag": "--force",
            "from": "param:force",
            "encoding": "boolean"
          },
          {
            "flag": "-q",
            "from": "param:q",
            "encoding": "boolean"
          },
          {
            "flag": "--dry-run",
            "from": "param:dryRun",
            "encoding": "boolean"
          }
        ]
      }
    }
  ],
  "sdk": {
    "mode": "cli",
    "timeout": {
      "defaultTimeoutMs": 60000,
      "onTimeout": "kill"
    },
    "errors": {
      "nonZeroExit": "raise",
      "errorName": "CliError"
    },
    "result": {
      "typeName": "CommandResult",
      "jsonHelper": true
    },
    "process": {
      "inheritEnv": true,
      "stdin": "null"
    },
    "clientOptions": {
      "optionKeys": [
        "binPath",
        "cwd",
        "env",
        "timeout"
      ]
    }
  }
}
