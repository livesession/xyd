{
  "opensdk": "1.0.0",
  "info": {
    "title": "enumcli",
    "version": "1.0.0"
  },
  "x-cli": {
    "bin": "enumcli",
    "envVar": "ENUMCLI_BIN",
    "opencli": "1.0.0"
  },
  "types": [
    {
      "name": "CommandResult",
      "kind": "struct",
      "fields": [
        {
          "name": "stdout",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "stderr",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "exitCode",
          "type": {
            "kind": "scalar",
            "scalar": "integer"
          },
          "required": true
        }
      ],
      "description": "The result of one CLI invocation. json() parses stdout as JSON."
    },
    {
      "name": "OneShell",
      "kind": "enum",
      "base": "string",
      "values": [
        {
          "value": "zsh"
        },
        {
          "value": "fish"
        }
      ]
    },
    {
      "name": "OneShell2",
      "kind": "enum",
      "base": "string",
      "values": [
        {
          "value": "bash"
        },
        {
          "value": "sh"
        }
      ]
    }
  ],
  "methods": [
    {
      "action": "one",
      "pathParams": [
        {
          "name": "shell",
          "type": {
            "kind": "ref",
            "name": "OneShell"
          },
          "required": true
        }
      ],
      "queryParams": [
        {
          "name": "shell",
          "type": {
            "kind": "ref",
            "name": "OneShell2"
          },
          "required": false,
          "description": "Override the shell"
        }
      ],
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [
          "one"
        ],
        "args": [
          {
            "from": "param:shell",
            "encoding": "string",
            "required": true
          }
        ],
        "options": [
          {
            "flag": "--shell",
            "from": "param:shell",
            "encoding": "string"
          }
        ]
      }
    },
    {
      "action": "two",
      "pathParams": [
        {
          "name": "shell",
          "type": {
            "kind": "ref",
            "name": "OneShell"
          },
          "required": true
        }
      ],
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [
          "two"
        ],
        "args": [
          {
            "from": "param:shell",
            "encoding": "string",
            "required": true
          }
        ]
      }
    }
  ],
  "sdk": {
    "mode": "cli",
    "timeout": {
      "defaultTimeoutMs": 60000,
      "onTimeout": "kill"
    },
    "errors": {
      "nonZeroExit": "raise",
      "errorName": "CliError"
    },
    "result": {
      "typeName": "CommandResult",
      "jsonHelper": true
    },
    "process": {
      "inheritEnv": true,
      "stdin": "null"
    },
    "clientOptions": {
      "optionKeys": [
        "binPath",
        "cwd",
        "env",
        "timeout"
      ]
    }
  }
}
