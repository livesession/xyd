{
  "opensdk": "1.0.0",
  "info": {
    "title": "misc",
    "version": "1.0.0"
  },
  "x-cli": {
    "bin": "misc",
    "envVar": "MISC_BIN",
    "opencli": "1.0.0"
  },
  "types": [
    {
      "name": "CommandResult",
      "kind": "struct",
      "fields": [
        {
          "name": "stdout",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "stderr",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "exitCode",
          "type": {
            "kind": "scalar",
            "scalar": "integer"
          },
          "required": true
        }
      ],
      "description": "The result of one CLI invocation. json() parses stdout as JSON."
    }
  ],
  "methods": [
    {
      "action": "publish",
      "description": "Publish the package",
      "queryParams": [
        {
          "name": "token",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": false,
          "description": "Auth token"
        }
      ],
      "responses": [
        {
          "status": "0",
          "description": "ok"
        },
        {
          "status": "2",
          "description": "config error"
        }
      ],
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [
          "publish"
        ],
        "options": [
          {
            "flag": "--token",
            "from": "param:token",
            "encoding": "string"
          }
        ],
        "interactive": true,
        "exitCodes": [
          {
            "code": 0,
            "description": "ok"
          },
          {
            "code": 2,
            "description": "config error"
          }
        ]
      }
    }
  ],
  "sdk": {
    "mode": "cli",
    "timeout": {
      "defaultTimeoutMs": 60000,
      "onTimeout": "kill"
    },
    "errors": {
      "nonZeroExit": "raise",
      "errorName": "CliError"
    },
    "result": {
      "typeName": "CommandResult",
      "jsonHelper": true
    },
    "process": {
      "inheritEnv": true,
      "stdin": "null"
    },
    "clientOptions": {
      "optionKeys": [
        "binPath",
        "cwd",
        "env",
        "timeout"
      ]
    }
  }
}
