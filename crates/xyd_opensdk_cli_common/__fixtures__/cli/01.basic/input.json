{
  "opensdk": "1.0.0",
  "info": {
    "title": "acme",
    "version": "1.0.0"
  },
  "x-cli": {
    "bin": "acme",
    "envVar": "ACME_BIN",
    "opencli": "1.0.0"
  },
  "types": [
    {
      "name": "CommandResult",
      "kind": "struct",
      "fields": [
        {
          "name": "stdout",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "stderr",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "exitCode",
          "type": {
            "kind": "scalar",
            "scalar": "integer"
          },
          "required": true
        }
      ],
      "description": "The result of one CLI invocation. json() parses stdout as JSON."
    }
  ],
  "methods": [
    {
      "action": "opt-version",
      "description": "Print the CLI version and exit",
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [],
        "options": [
          {
            "flag": "--version"
          }
        ]
      }
    },
    {
      "action": "status",
      "description": "Show status",
      "queryParams": [
        {
          "name": "format",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": false,
          "description": "Output format"
        }
      ],
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [
          "status"
        ],
        "options": [
          {
            "flag": "--format",
            "from": "param:format",
            "encoding": "string"
          }
        ]
      }
    }
  ],
  "resources": [
    {
      "name": "projects",
      "methods": [
        {
          "action": "list",
          "description": "List projects",
          "primaryResponse": {
            "kind": "ref",
            "name": "CommandResult"
          },
          "x-cli": {
            "command": [
              "projects",
              "list"
            ]
          }
        }
      ]
    }
  ],
  "sdk": {
    "mode": "cli",
    "timeout": {
      "defaultTimeoutMs": 60000,
      "onTimeout": "kill"
    },
    "errors": {
      "nonZeroExit": "raise",
      "errorName": "CliError"
    },
    "result": {
      "typeName": "CommandResult",
      "jsonHelper": true
    },
    "process": {
      "inheritEnv": true,
      "stdin": "null"
    },
    "clientOptions": {
      "optionKeys": [
        "binPath",
        "cwd",
        "env",
        "timeout"
      ]
    }
  }
}
