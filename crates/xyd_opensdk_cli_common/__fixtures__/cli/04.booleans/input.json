{
  "opensdk": "1.0.0",
  "info": {
    "title": "flags",
    "version": "1.0.0"
  },
  "x-cli": {
    "bin": "flags",
    "envVar": "FLAGS_BIN",
    "opencli": "1.0.0"
  },
  "types": [
    {
      "name": "CommandResult",
      "kind": "struct",
      "fields": [
        {
          "name": "stdout",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "stderr",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "exitCode",
          "type": {
            "kind": "scalar",
            "scalar": "integer"
          },
          "required": true
        }
      ],
      "description": "The result of one CLI invocation. json() parses stdout as JSON."
    }
  ],
  "methods": [
    {
      "action": "run",
      "description": "Run the thing",
      "queryParams": [
        {
          "name": "verbose",
          "type": {
            "kind": "scalar",
            "scalar": "boolean"
          },
          "required": false,
          "description": "Verbose output"
        },
        {
          "name": "q",
          "type": {
            "kind": "scalar",
            "scalar": "boolean"
          },
          "required": false,
          "description": "Quiet mode"
        },
        {
          "name": "count",
          "type": {
            "kind": "scalar",
            "scalar": "integer"
          },
          "required": false,
          "description": "How many"
        },
        {
          "name": "ratio",
          "type": {
            "kind": "scalar",
            "scalar": "number"
          },
          "required": false,
          "description": "A ratio"
        }
      ],
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [
          "run"
        ],
        "options": [
          {
            "flag": "--verbose",
            "from": "param:verbose",
            "encoding": "boolean"
          },
          {
            "flag": "-q",
            "from": "param:q",
            "encoding": "boolean"
          },
          {
            "flag": "--count",
            "from": "param:count",
            "encoding": "integer"
          },
          {
            "flag": "--ratio",
            "from": "param:ratio",
            "encoding": "number"
          }
        ]
      }
    }
  ],
  "sdk": {
    "mode": "cli",
    "timeout": {
      "defaultTimeoutMs": 60000,
      "onTimeout": "kill"
    },
    "errors": {
      "nonZeroExit": "raise",
      "errorName": "CliError"
    },
    "result": {
      "typeName": "CommandResult",
      "jsonHelper": true
    },
    "process": {
      "inheritEnv": true,
      "stdin": "null"
    },
    "clientOptions": {
      "optionKeys": [
        "binPath",
        "cwd",
        "env",
        "timeout"
      ]
    }
  }
}
