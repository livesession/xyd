{
  "opensdk": "1.0.0",
  "info": {
    "title": "packer",
    "version": "1.0.0"
  },
  "x-cli": {
    "bin": "packer",
    "envVar": "PACKER_BIN",
    "opencli": "1.0.0"
  },
  "types": [
    {
      "name": "CommandResult",
      "kind": "struct",
      "fields": [
        {
          "name": "stdout",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "stderr",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "exitCode",
          "type": {
            "kind": "scalar",
            "scalar": "integer"
          },
          "required": true
        }
      ],
      "description": "The result of one CLI invocation. json() parses stdout as JSON."
    }
  ],
  "methods": [
    {
      "action": "pack",
      "description": "Pack files",
      "pathParams": [
        {
          "name": "dest",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true,
          "description": "Destination archive"
        },
        {
          "name": "files",
          "type": {
            "kind": "array",
            "items": {
              "kind": "scalar",
              "scalar": "string"
            }
          },
          "required": true,
          "description": "Files to pack"
        }
      ],
      "queryParams": [
        {
          "name": "tag",
          "type": {
            "kind": "array",
            "items": {
              "kind": "scalar",
              "scalar": "string"
            }
          },
          "required": false,
          "description": "Tags to apply"
        },
        {
          "name": "meta",
          "type": {
            "kind": "any"
          },
          "required": false,
          "description": "Metadata as JSON"
        }
      ],
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [
          "pack"
        ],
        "args": [
          {
            "from": "param:dest",
            "encoding": "string",
            "required": true
          },
          {
            "from": "param:files",
            "encoding": "string",
            "required": true,
            "variadic": true
          }
        ],
        "options": [
          {
            "flag": "--tag",
            "from": "param:tag",
            "encoding": "string",
            "repeat": true
          },
          {
            "flag": "--meta",
            "from": "param:meta",
            "encoding": "json"
          }
        ]
      }
    }
  ],
  "sdk": {
    "mode": "cli",
    "timeout": {
      "defaultTimeoutMs": 60000,
      "onTimeout": "kill"
    },
    "errors": {
      "nonZeroExit": "raise",
      "errorName": "CliError"
    },
    "result": {
      "typeName": "CommandResult",
      "jsonHelper": true
    },
    "process": {
      "inheritEnv": true,
      "stdin": "null"
    },
    "clientOptions": {
      "optionKeys": [
        "binPath",
        "cwd",
        "env",
        "timeout"
      ]
    }
  }
}
