{
  "opensdk": "1.0.0",
  "info": {
    "title": "acme",
    "version": "1.0.0"
  },
  "x-cli": {
    "bin": "acme",
    "envVar": "ACME_BIN",
    "opencli": "1.0.0"
  },
  "types": [
    {
      "name": "CommandResult",
      "kind": "struct",
      "fields": [
        {
          "name": "stdout",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "stderr",
          "type": {
            "kind": "scalar",
            "scalar": "string"
          },
          "required": true
        },
        {
          "name": "exitCode",
          "type": {
            "kind": "scalar",
            "scalar": "integer"
          },
          "required": true
        }
      ],
      "description": "The result of one CLI invocation. json() parses stdout as JSON."
    },
    {
      "name": "ConvertTarget",
      "kind": "enum",
      "base": "string",
      "values": [
        {
          "value": "json-pretty"
        },
        {
          "value": "yaml"
        },
        {
          "value": "xml"
        }
      ]
    },
    {
      "name": "ConvertLevel",
      "kind": "enum",
      "base": "string",
      "values": [
        {
          "value": "debug-verbose"
        },
        {
          "value": "info"
        },
        {
          "value": "warn"
        }
      ]
    }
  ],
  "methods": [
    {
      "action": "convert",
      "description": "Convert a document",
      "pathParams": [
        {
          "name": "target",
          "type": {
            "kind": "ref",
            "name": "ConvertTarget"
          },
          "required": true,
          "description": "Output format"
        }
      ],
      "queryParams": [
        {
          "name": "level",
          "type": {
            "kind": "ref",
            "name": "ConvertLevel"
          },
          "required": false,
          "description": "Verbosity level"
        }
      ],
      "primaryResponse": {
        "kind": "ref",
        "name": "CommandResult"
      },
      "x-cli": {
        "command": [
          "convert"
        ],
        "args": [
          {
            "from": "param:target",
            "encoding": "string",
            "required": true
          }
        ],
        "options": [
          {
            "flag": "--level",
            "from": "param:level",
            "encoding": "string"
          }
        ]
      }
    }
  ],
  "sdk": {
    "mode": "cli",
    "timeout": {
      "defaultTimeoutMs": 60000,
      "onTimeout": "kill"
    },
    "errors": {
      "nonZeroExit": "raise",
      "errorName": "CliError"
    },
    "result": {
      "typeName": "CommandResult",
      "jsonHelper": true
    },
    "process": {
      "inheritEnv": true,
      "stdin": "null"
    },
    "clientOptions": {
      "optionKeys": [
        "binPath",
        "cwd",
        "env",
        "timeout"
      ]
    }
  }
}
