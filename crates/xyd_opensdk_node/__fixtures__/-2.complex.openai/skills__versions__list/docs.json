  "action": "list",
  "usage": "import Openai from \"openai\";\n\nconst client = new Openai({\n  apiKey: process.env[\"OPENAI_API_KEY\"],\n});\n\nconst result = await client.skills.versions.list(\"skill_123\", { limit: 1, order: \"asc\", after: \"skillver_123\" });\nconsole.log(result);\n",
