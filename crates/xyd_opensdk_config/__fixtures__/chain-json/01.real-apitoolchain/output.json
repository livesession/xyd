      "options": {
        "packageName": "@apitoolchain/api-node",
        "tests": false
      },
      "publish": null,
      "tests": null
    },
    "api-cli": {
      "target": "rust-cli",
      "source": "api",
      "output": "../apitoolchain-api-cli",
      "sdkName": null,
      "behavior": null,
      "grouping": null,
      "options": {
        "cliName": "apitoolchain"
      },
      "publish": null,
      "tests": null
