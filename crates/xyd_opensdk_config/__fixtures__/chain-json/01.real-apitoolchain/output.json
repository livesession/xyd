        {
          "location": "../../apps/apitoolchain-gitprovider/openapi/__generated__/openapi.yaml"
        }
      ],
      "overlays": null,
      "output": "./.chain/gitprovider.openapi.json"
    },
    "registry-api": {
      "inputs": [
        {
          "location": "../../apps/apitoolchain-registry-api/openapi/v1/__generated__/openapi.yaml"
        }
      ],
      "overlays": null,
      "output": "./.chain/registry-api.openapi.json"
    },
    "api": {
      "inputs": [
        {
          "location": "../../apps/apitoolchain-api/openapi/v1/__generated__/openapi.yaml"
        }
      ],
      "overlays": null,
      "output": "./.chain/api.openapi.json"
    }
  },
  "targets": {
    "gitprovider-node": {
      "target": "node",
      "source": "gitprovider",
      "output": "../apitoolchain-gitprovider-node",
      "sdkName": "gitprovider",
      "behavior": null,
      "grouping": null,
      "options": {
