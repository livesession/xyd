{
  "name": "@xyd-js/opensdk-merge",
  "version": "0.1.0-build.0",
  "description": "3-way merge primitive for OpenSDK regeneration: preserve hand-edits to generated files by merging base/ours/theirs with git-style conflict markers",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "pnpm clean",
    "build": "tsup",
    "test": "vitest",
    "ci:test": "vitest run",
    "format": "bunx biome check --write src"
  },
  "dependencies": {
    "diff": "^5.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "rimraf": "^3.0.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
