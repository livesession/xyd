{
  "description": "A REAL 74KB generated OpenAPI YAML (apps/apitoolchain-api) merged with an extra doc + overlaid: exercises the yaml loader, merge and serialisation at realistic scale.",
  "ops": [
    {
      "id": "read-yaml",
      "op": "readRawDoc",
      "location": "./specs/platform.yaml"
    },
    {
      "id": "process",
      "op": "processSource",
      "source": {
        "inputs": [
          {
            "location": "./specs/platform.yaml"
          },
          {
            "location": "./specs/extra.json"
          }
        ],
        "overlays": [
          {
            "location": "./overlays/ov.json"
          }
        ],
        "output": "./out/platform.openapi.json"
      }
    }
  ]
}
