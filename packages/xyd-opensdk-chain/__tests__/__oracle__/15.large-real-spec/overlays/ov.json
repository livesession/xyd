{
  "overlay": "1.0.0",
  "info": {
    "title": "platform overlay",
    "version": "1.0.0"
  },
  "actions": [
    {
      "target": "$.info",
      "update": {
        "description": "overlaid platform api"
      }
    },
    {
      "target": "$.paths['/api-keys'].get",
      "update": {
        "x-overlaid": true
      }
    },
    {
      "target": "$.paths['/api-keys/{apiKeyId}']",
      "remove": true
    }
  ]
}
