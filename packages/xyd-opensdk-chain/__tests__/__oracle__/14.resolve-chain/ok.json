{
  "$schema": "https://example.com/chain.schema.json",
  "version": 1,
  "behavior": {
    "retry": {
      "maxRetries": 5
    }
  },
  "publish": {
    "registry": "https://registry.example.com",
    "tokenEnv": "TOK"
  },
  "sources": {
    "pet": {
      "inputs": [
        {
          "location": "./spec.json"
        }
      ],
      "overlays": [
        {
          "location": "./ov.json"
        }
      ],
      "output": "./.chain/pet.json"
    }
  },
  "targets": {
    "pet-go": {
      "target": "go",
      "source": "pet",
      "output": "./sdk/go",
      "sdkName": "pet",
      "tests": false,
      "options": {
        "modulePath": "example.com/pet"
      }
    },
    "pet-ts": {
      "target": "typescript",
      "source": "pet",
      "grouping": {
        "mountRules": {
          "/pets": "pets"
        }
      }
    }
  }
}
