{
  "chain": [
    "evals"
  ],
  "action": "list",
  "usage": "import os\n\nfrom openai import Client\n\nclient = Client(\n    api_key=os.environ.get(\"OPENAI_API_KEY\"),\n)\n\nresult = client.evals.list(after=\"after\", limit=20, order=\"asc\", order_by=\"created_at\")\nprint(result)\n",
  "typeReference": {
    "signature": "client.evals.list(after=..., limit=..., order=..., order_by=...) -> CursorPage[Eval]",
    "request": {
      "fields": [
        {
          "name": "after",
          "langType": "Optional[str]",
          "required": false,
          "description": "Identifier for the last eval from the previous pagination request."
        },
        {
          "name": "limit",
          "langType": "Optional[int]",
          "required": false,
          "description": "Number of evals to retrieve."
        },
        {
          "name": "order",
          "langType": "Optional[EvalsListOrder]",
          "required": false,
          "description": "Sort order for evals by timestamp. Use `asc` for ascending order or `desc` for descending order.",
          "refTypeName": "EvalsListOrder"
        },
        {
          "name": "order_by",
          "langType": "Optional[EvalsListOrderBy]",
          "required": false,
          "description": "Evals can be ordered by creation time or last updated time. Use\n`created_at` for creation time or `updated_at` for last updated time.\n",
          "refTypeName": "EvalsListOrderBy"
        }
      ]
    },
    "response": {
      "typeName": "CursorPage[Eval]",
      "note": "paginated (CursorPage)",
      "fields": [
        {
          "name": "object",
          "langType": "str",
          "required": true,
          "description": "The object type."
        },
        {
          "name": "id",
          "langType": "str",
          "required": true,
          "description": "Unique identifier for the evaluation."
        },
        {
          "name": "name",
          "langType": "str",
          "required": true,
          "description": "The name of the evaluation."
        },
        {
          "name": "data_source_config",
          "langType": "EvalDataSourceConfig",
          "required": true,
          "description": "Configuration of data sources used in runs of the evaluation.",
          "refTypeName": "EvalDataSourceConfig"
        },
        {
          "name": "testing_criteria",
          "langType": "list[EvalTestingCriteriaItem]",
          "required": true,
          "description": "A list of testing criteria."
        },
        {
          "name": "created_at",
          "langType": "int",
          "required": true,
          "description": "The Unix timestamp (in seconds) for when the eval was created."
        },
        {
          "name": "metadata",
          "langType": "Metadata",
          "required": true,
          "refTypeName": "Metadata"
        }
      ]
    }
