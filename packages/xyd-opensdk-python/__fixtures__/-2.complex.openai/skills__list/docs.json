{
  "chain": [
    "skills"
  ],
  "action": "list",
  "usage": "import os\n\nfrom openai import Client\n\nclient = Client(\n    api_key=os.environ.get(\"OPENAI_API_KEY\"),\n)\n\nresult = client.skills.list(limit=1, order=\"asc\", after=\"after\")\nprint(result)\n",
  "typeReference": {
    "signature": "client.skills.list(limit=..., order=..., after=...) -> CursorPage[SkillResource]",
    "request": {
      "fields": [
        {
          "name": "limit",
          "langType": "Optional[int]",
          "required": false,
          "description": "Number of items to retrieve"
        },
        {
          "name": "order",
          "langType": "Optional[OrderEnum]",
          "required": false,
          "description": "Sort order of results by timestamp. Use `asc` for ascending order or `desc` for descending order.",
          "refTypeName": "OrderEnum"
        },
        {
          "name": "after",
          "langType": "Optional[str]",
          "required": false,
          "description": "Identifier for the last item from the previous pagination request"
        }
      ]
    },
    "response": {
      "typeName": "CursorPage[SkillResource]",
      "note": "paginated (CursorPage)",
      "fields": [
        {
          "name": "id",
          "langType": "str",
          "required": true,
          "description": "Unique identifier for the skill."
        },
        {
          "name": "object",
          "langType": "str",
          "required": true,
          "description": "The object type, which is `skill`."
        },
        {
          "name": "name",
          "langType": "str",
          "required": true,
          "description": "Name of the skill."
        },
        {
          "name": "description",
          "langType": "str",
          "required": true,
          "description": "Description of the skill."
        },
        {
          "name": "created_at",
          "langType": "int",
          "required": true,
          "description": "Unix timestamp (seconds) for when the skill was created."
        },
        {
          "name": "default_version",
          "langType": "str",
          "required": true,
          "description": "Default version for the skill."
        },
        {
          "name": "latest_version",
          "langType": "str",
          "required": true,
          "description": "Latest version for the skill."
        }
      ]
    }
  }
}
