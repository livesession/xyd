{
  "name": "@xyd-js/vite-plugin",
  "version": "0.1.0-build.0",
  "description": "Vite plugin that builds an xyd docs project during `vite build` and merges the static docs output into the host app's build",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "pnpm clean",
    "build": "tsup",
    "test": "vitest",
    "ci:test": "vitest run"
  },
  "keywords": [
    "xyd",
    "vite",
    "vite-plugin",
    "docs",
    "documentation"
  ],
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "rimraf": "^3.0.2",
    "tsup": "^8.3.0",
    "vite": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
